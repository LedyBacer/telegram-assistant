TELEGRAM_BOT_TOKEN=replace-me

PUBLIC_BASE_URL=https://example.com

DATABASE_URL=postgresql+asyncpg://assistant:assistant@postgres:5432/assistant

# AI providers — chat/generation and embeddings may be served by two
# separate OpenAI-compatible servers (e.g. two llama.cpp instances), each
# with its own base URL, API key, and model.
#
# Chat / structured generation (qwen3.5-9b-64k):
CHAT_BASE_URL=http://llm-host:18085/v1
CHAT_API_KEY=replace-me
CHAT_MODEL=qwen3.5-9b-64k
# Seconds the application waits for a chat completion before giving up.
# llama.cpp reasoning can take longer than the OpenAI client's implicit
# 60 s default, so this is explicit (default 180).
CHAT_TIMEOUT_SECONDS=180
# Qwen thinking (reasoning) mode, sent to llama.cpp as
# chat_template_kwargs.enable_thinking.
#
# Qwen3.5 quality profile: enable thinking. Settings still defaults to
# false when this variable is absent, so generic/non-Qwen deployments are not
# forced into reasoning mode. The bot shows "Thinking…" / "Думаю…" while it runs.
CHAT_THINKING_ENABLED=true
# Optional llama.cpp per-request reasoning budget. Leave unset for unrestricted
# thinking (recommended first quality baseline). If latency/overthinking is too
# high, try e.g. 4096 and measure quality.
#CHAT_THINKING_BUDGET_TOKENS=4096
# Advanced/custom-template knob. Stock Qwen3.5 is not trained with a reliable
# low/medium/high effort scale; prefer the switch + optional token budget.
#CHAT_REASONING_EFFORT=medium

# Embeddings / RAG (multilingual-e5-small, 384-dim vectors, E5 prefixes).
# OPTIONAL: leave this whole block unset to run chat-only. Without an
# embedding provider, document uploads are rejected visibly and document
# search degrades to lexical-only; /readyz reports ai_embedding "degraded".
# Every other feature (chat, actions, facts, workouts, calendar, reminders)
# works unchanged.
EMBEDDING_BASE_URL=http://llm-host:18086/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# Legacy single-provider fallback (optional): when CHAT_* / EMBEDDING_*
# base-URL/key variables are absent, these are used for both providers.
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_KEY=replace-me

LOG_LEVEL=INFO

MINIAPP_AUTH_MAX_AGE_SECONDS=900

MAX_UPLOAD_SIZE_BYTES=20971520
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# ONE consistent absolute path shared by bot/api/worker. Inside the
# containers the Dockerfile already sets FILE_STORAGE_DIR=/data/storage/files
# and compose mounts ./storage at /data/storage, so all three processes read
# and write the same files. For a non-Docker local run point it at any local
# absolute directory (e.g. /tmp/assistant-storage/files).
FILE_STORAGE_DIR=/data/storage/files
EMBEDDING_BATCH_SIZE=64
# Ingestion resource safety: per-file bounds so hostile/compressed documents
# cannot cause unbounded CPU/memory work. A file whose extracted text exceeds
# MAX_EXTRACTED_TEXT_CHARS, whose chunk count exceeds MAX_CHUNKS_PER_FILE, or
# whose PDF has more than MAX_PDF_PAGES pages fails visibly (state=failed).
MAX_EXTRACTED_TEXT_CHARS=2000000
MAX_CHUNKS_PER_FILE=2000
MAX_PDF_PAGES=500
# Meaningful-relevance bound for vector retrieval: a semantic candidate is
# dropped when its cosine distance to the query exceeds this value
# (0 = identical, 1 = orthogonal, 2 = opposite). Lower = stricter/precision,
# higher = more recall. Lexical (keyword) matches are always kept.
RETRIEVAL_MAX_DISTANCE=0.9
# Adjacent-chunk merging: retrieved chunks from the same file whose positions
# are within this many steps of each other are merged into one bounded excerpt
# (1 = strictly consecutive; larger bridges a small gap of un-retrieved chunks).
RETRIEVAL_MERGE_GAP=1
CHAT_HISTORY_MESSAGES=10

WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_BATCH_SIZE=10
JOB_MAX_ATTEMPTS=3
DIGEST_SCHEDULE_INTERVAL_SECONDS=30.0
